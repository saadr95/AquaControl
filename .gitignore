# ── OS / editor cruft ──────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
.history/

# ── KiCad — generated/derived fabrication output (regenerate from the
# .kicad_pcb/.kicad_sch source files any time via Plot / Fabrication
# Toolkit) — only the design source is tracked, not its exports.
*.gbr
*.gbrjob
*.drl
*.pos
*.step
*.net
DRC.rpt
report.txt
AquaControl_report.txt
AquaControl-backups/
production/
dfm/
grb/
bom/
BOM1/
~*.lck

# ── Android release APK — large regenerable build artifact, not source.
# Rebuild via AquaControlApp/README.md; keep a copy locally if you want
# one on hand, just don't check it into git.
*.apk

# ── ESP32 firmware build output and compiled binaries — regenerable via
# arduino-cli/Arduino IDE, and firmware.bin ships through GitHub Releases
# (see AquaControl/releases/README.md), not through the repo tree.
AquaControl/build/
AquaControl/releases/*.bin

# ── One-off verification scripts written during a session — not part of
# the deliverable, safe to delete/regenerate any time.
web-dashboard/test-*.mjs
